public class BST<T> {
BSTNode<T> root, current;

public BST() {
root = current = null;
}

public boolean empty(){
return root == null;
}

public boolean full(){
return false;
}

public T retrieve() {
		return current.data;
	}

public void update(T val) {
		current.data = val;
	}

public boolean findkey(int tkey) {
		BSTNode<T> p,q;
p = root;
q = root;
				
		if(empty())
			return false;
		
		while(p != null) {
			q = p;
			if(p.key == tkey) {
				current = p;
				return true;
			}
			else if(tkey < p.key)
				p = p.left;
			else
				p = p.right;
		}
		
		current = q;
		return false;
	}



}
